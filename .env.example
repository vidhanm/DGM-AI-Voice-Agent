# LLM API Keys (choose one)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here  # FREE! Get from https://cloud.cerebras.ai

# LiveKit Configuration
# Sign up at https://cloud.livekit.io for free tier
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Voice: Speech-to-Text (STT) Provider
# Deepgram (recommended): Sign up at https://console.deepgram.com ($200 free credit)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Voice: Text-to-Speech (TTS) Provider
# Cartesia (recommended): Sign up at https://cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key

# Alternative voice providers (optional)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key  # Alternative TTS
# ASSEMBLYAI_API_KEY=your_assemblyai_api_key  # Alternative STT

# LLM Configuration
LLM_PROVIDER=cerebras  # openai, anthropic, or cerebras (FREE!)
LLM_MODEL=qwen-3-235b-a22b-instruct-2507  # cerebras: llama-3.3-70b, llama3.1-70b, qwen-3-235b-a22b-instruct-2507
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=3000

# Evolution Configuration
MAX_GENERATIONS=20
SUCCESS_THRESHOLD=85
PLATEAU_GENERATIONS=5
CONVERSATIONS_PER_PERSONA=3

# Logging
LOG_LEVEL=INFO
LOG_DIR=data/logs

# Database
DATABASE_URL=sqlite:///data/agents.db
